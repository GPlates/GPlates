class GpmlPiecewiseAggregation(PropertyValue):
    """A time-dependent property consisting of a sequence of time windows each with a *constant* property value.

    GpmlPiecewiseAggregation behaves like a regular python ``list`` (of :class:`GpmlTimeWindow` elements) in that the following operations are supported:

