    'relative-stage-rotation': 'pygplates_primer_relative_stage_rotation',
    'relative-total-rotation': 'pygplates_primer_relative_total_rotation',
    'rift-edge-length-threshold': 'pygplates_primer_exponential_rift_stretching_profile',
    'rift-exponential-stretching-constant': 'pygplates_primer_exponential_rift_stretching_profile',
    'rift-left-right-plate-ids': 'pygplates_primer_exponential_rift_stretching_profile',
