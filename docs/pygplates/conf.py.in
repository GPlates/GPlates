#
# Repair docstrings whose body does not get dedented by Sphinx.
#
# Our docstrings are hand written with the convention that the first line is the signature and
# the body is indented two spaces, eg:
#
#     wrap(geometry, [tessellate_degrees])
#       Wrap a geometry to the range ...
#
#       :param geometry: the geometry to wrap
#       :type geometry: :class:`GeometryOnSphere`
#
# However Boost.Python concatenates the docstrings of overloaded 'def()'s - and repeats the
# docstring when a 'def()' also provides the default implementation of a virtual function
# (as PropertyValueVisitor does) - so one '__doc__' can hold several of these blocks.
#
# That breaks Sphinx, because 'sphinx.util.docstrings.prepare_docstring()' dedents the docstring
# by the smallest indent it finds over the second and subsequent lines. The extra signature lines
# sit at column zero, so that margin is zero and *nothing* gets dedented. The still-indented body
# is then read as a block quote, which puts the field list out of reach of the Python domain:
# it renders as literal "param geometry:" text instead of a "Parameters:" table.
#
# Sphinx's own support for several signature lines is not an alternative: since 3.1
# 'autodoc_docstring_signature' does consume multiple signature lines, but only when they are
# contiguous from line 0 and share ONE body ('_extract_signatures_from_docstrings'), which would
# collapse the per-overload Parameters/Raises/example blocks into one. Nor is there a native
# "overload with its own body" rendering ('sphinx_toolbox.more_autodoc.overloads' only handles
# 'typing.overload' in Python source, not C-extension docstrings).
#
# So split the docstring on those signature lines and dedent each block ourselves. Note that
# Sphinx has already taken the first line as this member's signature by the time we are called
# (see 'autodoc_docstring_signature' above), so the surviving signature lines are ours to render:
# we re-emit each one as a 'py:method'/'py:function' directive whose content is that block's body.
# That gives every overload the same Python-domain styling as the first one (bold name, italic
# parameters) and, more importantly, puts its field list at the top level of a Python object
# description - so ':param:'/':type:'/':rtype:' parse natively instead of as literal text.
# The directives carry ':no-index:' because the member is already indexed by the first overload.
#
# A trailing '.. versionadded::' or '.. versionchanged::' written at column zero (rather than
# indented with the body it belongs to) zeroes the margin in exactly the same way, so ignore
# such a directive when measuring a block. It is already flush with where the block's top level
# will be, so it is left untouched while the body around it is dedented to join it. That has to cover
# the lines indented *under* the directive as well, since they are its content and are already
# positioned relative to it.
#
_SIGNATURE_RE = re.compile(r'^(\w+)\s*\(.*\)\s*$')
_FLUSH_DIRECTIVE_RE = re.compile(r'^\.\.\s')

def flush_directive_lines(body):
    """
    Flag the lines of any directive written at column zero, including its indented content.

    A blank line ends the run: directive content is not separated from the directive by one, so
    anything after a blank line is body again (and does need dedenting).
    """
    flagged = []
    inside = False
    for line in body:
        if not line.strip():
            inside = False
        elif not (len(line) - len(line.lstrip())):
            inside = bool(_FLUSH_DIRECTIVE_RE.match(line))
        flagged.append(inside)
    return flagged

def dedent_docstring_block(body, skip_first_line):
    """
    Remove the common leading indent, and any leading/trailing blank lines, from one block.

    'skip_first_line' excludes the first line when measuring the indent, because
    'prepare_docstring()' left-strips the first line of a docstring but dedents the rest by a
    common margin - so in the first block (the only one whose signature line Sphinx consumed)
    the first line is already flush while the rest are still indented.
    """
    flagged = flush_directive_lines(body)
    measured = [line for i, line in enumerate(body)
                if line.strip() and not flagged[i] and not (skip_first_line and not i)]
    margin = min((len(line) - len(line.lstrip()) for line in measured), default=0)

    block = []
    for i, line in enumerate(body):
        if not line.strip():
            block.append('')
        elif flagged[i] or len(line) - len(line.lstrip()) < margin:
            # A top-level directive, or the already-flush first line - both are where they
            # should be, so leave them alone.
            block.append(line)
        else:
            block.append(line[margin:])

    while block and not block[0]:
        del block[0]
    while block and not block[-1]:
        del block[-1]
    return block

def resolve_dotted_name(dotted_name):
    """
    Look up an already-imported object by its dotted name (eg, 'pygplates.LocalCartesian').

    Autodoc has imported the module by the time it calls us, so the longest importable prefix of
    the name is in 'sys.modules' - the rest is attribute access from there.
    """
    parts = dotted_name.split('.')
    for num_module_parts in range(len(parts), 0, -1):
        obj = sys.modules.get('.'.join(parts[:num_module_parts]))
        if obj is None:
            continue
        for attribute in parts[num_module_parts:]:
            obj = getattr(obj, attribute, None)
            if obj is None:
                return None
        return obj
    return None

def is_static_method(name):
    """
    Whether the member with dotted name 'name' is a static method of its containing class.

    Boost.Python's 'staticmethod()' installs a real 'staticmethod' descriptor, so 'getattr_static'
    (which does not invoke the descriptor protocol, unlike 'getattr') sees it.
    """
    parent_name, _, member_name = name.rpartition('.')
    parent = resolve_dotted_name(parent_name) if parent_name else None
    if not inspect.isclass(parent):
        return False
    try:
        return isinstance(inspect.getattr_static(parent, member_name), staticmethod)
    except AttributeError:
        return False

def signature_directive_lines(what, name, signature, body):
    """
    Render one extra signature block as a Python-domain directive with the body as its content.

    Note: No module-level function currently has extra overload blocks, so the 'py:function'
    branch has never been exercised by a real build - check the rendered page the first time
    one appears.
    """
    directive = 'method' if what == 'method' else 'function'
    directive_lines = ['.. py:%s:: %s' % (directive, signature), '   :no-index:']
    if directive == 'method' and is_static_method(name):
        directive_lines.append('   :staticmethod:')
    directive_lines.append('')
    # Indent the body to become the directive's content. Blank lines stay empty, and lines that
    # 'dedent_docstring_block()' deliberately left in place (a flush directive and its content)
    # shift along with everything else, so the block keeps its shape.
    directive_lines.extend('   ' + line if line else '' for line in body)
    return directive_lines

def process_docstring(app, what, name, obj, options, lines):
    member_name = name.rsplit('.', 1)[-1]

    # Split into blocks on column-zero signature lines for *this* member. Requiring the name to
    # match keeps us from splitting on an unrelated line that happens to look like a call, and
    # only overloadable members can pick up extra signature lines in the first place (a class
    # docstring is free to open a paragraph with something that reads like a call).
    # The first block has no signature line of its own - Sphinx has already consumed it.
    blocks = [(None, [])]
    for line in lines:
        match = _SIGNATURE_RE.match(line)
        if match and match.group(1) == member_name and what in ('function', 'method'):
            blocks.append((line.strip(), []))
        else:
            blocks[-1][1].append(line)

    output = []
    previous_bodies = []
    for signature, body in blocks:
        body = dedent_docstring_block(body, skip_first_line=signature is None)
        # Drop a block that repeats an earlier one verbatim (the virtual-function case above).
        # An empty body is not evidence of a repeat, so never match on one.
        if body and body in previous_bodies:
            continue
        previous_bodies.append(body)
        if output:
            output.append('')
        if signature is None:
            output.extend(body)
        else:
            output.extend(signature_directive_lines(what, name, signature, body))

    # 'prepare_docstring()' guarantees a trailing blank line - keep that guarantee.
    output.append('')
    lines[:] = output


# -- Primer anchor redirect ----------------------------------------------------

# The Primer was once a single page, 'pygplates_primer.html', and links to its sections are
# published outside these docs. Those links used two kinds of anchor: a label's (eg,
# '#pygplates-primer-topological-model'), which 'write_primer_anchors' finds for itself, and a
# section title's (eg, '#topological-model'), which its table of contents and permalinks used.
# A title's anchor is not unique across pages - a later page may well have its own "Velocities" -
# so each one the old page had is listed here, frozen, against the label of the section it belonged
# to (or, for an unlabelled section, the label of the section containing it).
#
# Sphinx's numbered anchors ('#id1', ...) are deliberately absent: they depend on the order of the
# sections on a page, so a number on the old page means something else on every new one.
_OLD_PRIMER_TITLE_ANCHORS = {
    'composing-finite-rotations': 'pygplates_primer_composing_finite_rotations',
    'crustal-thickness-factors':
