    'strain-rate-smoothing': 'pygplates_primer_strain_rate_smoothing',
    'strain-rates': 'pygplates_primer_reconstructed_geometry_time_span_strain_rates',
    'strain-rates-in-triangulation': 'pygplates_primer_strain_rates_in_triangulation',
    'strains': 'pygplates_primer_reconstructed_geometry_time_span_strains',
    'tectonic-subsidence': 'pygplates_primer_reconstructed_geometry_time_span_tectonic_subsidence',
    'time-spans': 'pygplates_primer_using_topological_reconstruction_time_spans',
    'topological-model': 'pygplates_primer_topological_model',
    'topological-network': 'pygplates_primer_topological_network',
    'topological-snapshot': 'pygplates_primer_topological_snapshot',
    'topologically-reconstruct-geometries': 'pygplates_primer_topologically_reconstruct_geometries',
    'topologies': 'pygplates_primer_topologies',
    'topology-locations': 'pygplates_primer_reconstructed_geometry_time_span_topology_locations',
    'using-topological-reconstruction': 'pygplates_primer_using_topological_reconstruction',
    'velocities': 'pygplates_primer_reconstructed_geometry_time_span_velocities',
    'what-is-topological-reconstruction': 'pygplates_primer_what_is_topological_reconstruction',
    'working-with-finite-rotations': 'pygplates_primer_working_with_finite_rotations'}

def write_primer_anchors(app, exception):
    """
    Write '_static/primer_anchors.js', which maps an old Primer anchor to the page now holding it.

    A script on 'pygplates_primer.rst' looks up the anchor of a link to the old single-page Primer
    in this map, and redirects to the page. Each anchor's page comes from the label of its
    section, so the map follows a section that moves to another page.

    Warns (an error under '-W') if an anchor would redirect to a page that does not have it: a
    label removed, or a new section on the same page taking a title's anchor from an old one.
    """
    # By name, not 'app.builder.format': 'dirhtml', 'singlehtml' and 'epub' are also 'html' format,
    # but lay the pages out differently, so the pages in the map would be wrong for them.
    if exception is not None or app.builder.name != 'html':
        return

    from sphinx.util import logging
    logger = logging.getLogger(__name__)

    # Label name -> (docname, anchor, section title), for every label in the documentation.
    labels = app.env.get_domain('std').labels

    anchors = {}
    for label, (docname, anchor, _) in labels.items():
        if label.startswith('pygplates_primer_') and docname.startswith('primer/'):
            anchors[anchor] = app.builder.get_target_uri(docname)
    for anchor, label in _OLD_PRIMER_TITLE_ANCHORS.items():
        if label not in labels:
            logger.warning(f"the old Primer anchor '#{anchor}' cannot be redirected: its label "
                           f"'{label}' no longer exists (see '_OLD_PRIMER_TITLE_ANCHORS' in "
                           f"conf.py)")
            continue
        anchors[anchor] = app.builder.get_target_uri(labels[label][0])

    page_ids = {}
    for anchor, page in sorted(anchors.items()):
        if page not in page_ids:
            with open(os.path.join(app.builder.outdir, page), encoding='utf-8') as html:
                page_ids[page] = set(_HTML_ID_RE.findall(html.read()))
        if anchor not in page_ids[page]:
            logger.warning(f"the old Primer anchor '#{anchor}' redirects to '{page}', which has no "
                           f"such anchor (see '_OLD_PRIMER_TITLE_ANCHORS' in conf.py)")

    with open(os.path.join(app.builder.outdir, '_static', 'primer_anchors.js'), 'w',
              encoding='utf-8') as js:
        js.write('// Generated by write_primer_anchors() in conf.py - do not edit.\n')
        js.write('var PRIMER_ANCHORS = ' + json.dumps(anchors, indent=1, sort_keys=True) + ';\n')

_HTML_ID_RE = re.compile(r'\bid="([^"]+)"')
